# Credentials, and local leftovers. Everything that is not a credential belongs in
# kojutsu.toml, which is committed and reviewed; see docs/configuration.md.
# A credential-named key in that file is refused at load time, so this is the only
# place a token belongs.
# Fine-grained token, limited to the one repository being captured.
# Needs only: Metadata (read), Pull requests (read), Issues (read+write).
# Not Contents. A classic token carrying `repo` is refused at runtime; see
# docs/github-seam.md.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
LLM_PROVIDER=ollama
LLM_MODEL=ollama/gpt-oss:20b
LLM_API_KEY=
LLM_EXTERNAL_ENABLED=false
LLM_ALLOWED_REPOSITORIES=
LLM_TIMEOUT_SECONDS=30
LLM_RETRIES=1
OLLAMA_URL=http://localhost:11434

# Tanseki knowledge store (the consumer seam). Required.
TANSEKI_URL=
TANSEKI_API_KEY=
TANSEKI_COLLECTION=kojutsu-real
TANSEKI_TIMEOUT_SECONDS=10
TANSEKI_OUTBOX_PATH=~/.kojutsu/tanseki-outbox.db

# Local SQLite registry for ingestion state (questions, dedupe, sessions).
# These paths are for non-Docker runs. The documented Docker command overrides
# both databases to /data so container state stays on the mounted volume.
KOJUTSU_REGISTRY_PATH=~/.kojutsu/registry.db
KOJUTSU_SQLITE_WORKERS=1
KOJUTSU_SQLITE_REPLICAS=1

# Dev console. Public binds require this token and --allow-insecure-bind.
DEV_CONSOLE_TOKEN=

# Read log: one local JSON Lines event per call to the MCP read server, so an
# operator can see that knowledge was read. Off by default, and that is the
# decision rather than a placeholder: a read log is a behavioural record, it
# cannot be backfilled, and turning it on fixes a start date no report can move
# earlier. It records the tool, the caller's query and stated filters, the result
# count, any exclusions, the outcome, and the time -- never document bodies, and
# never who asked, because a stdio server cannot know. Bounded on both age and
# entry count; anything removed is reported on the server's stderr.
# See docs/design-review/read-log.md.
READ_LOG_ENABLED=false
READ_LOG_PATH=~/.kojutsu/read-log.jsonl
READ_LOG_MAX_AGE_DAYS=7
READ_LOG_MAX_ENTRIES=10000

# Required for GitHub webhook processing. Empty rejects all repositories. Use
# comma-separated owner/repo values. "*" allows any repository only for a local
# webhook URL; public webhook URLs require explicit repositories.
GITHUB_WEBHOOK_ALLOWED_REPOSITORIES=

# How many GitHub reads `kojutsu backfill-reviews` may have in flight at once
# (default 8, max 32). This bounds concurrency, not the request rate: at 8 an
# 88-page history walk finishes in ~15s instead of ~115s and spends the same
# number of requests from the same hourly budget, just faster. Set it to 1 on a
# shared token for the strictly sequential walk. See docs/github-seam.md.
GITHUB_HISTORY_CONCURRENCY=
